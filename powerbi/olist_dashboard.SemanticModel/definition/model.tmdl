model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["Customer","Date","Product","Seller","Order Items","Orders","_Measures","Customer Value"]

ref table Customer
ref table Date
ref table Product
ref table Seller
ref table 'Order Items'
ref table Orders
ref table _Measures
ref table 'Customer Value'

ref cultureInfo en-US

