table _Measures
	lineageTag: cb5d3adb-b403-4f18-9c2e-66081bc0a41f

	measure GMV = CALCULATE ( SUM ( 'Order Items'[price] ), 'Order Items'[is_delivered] = TRUE () )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Sales
		lineageTag: 032956fc-bcdb-48ae-9499-07130afbaed2

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure Freight =
			
			CALCULATE ( SUM ( 'Order Items'[freight_value] ), 'Order Items'[is_delivered] = TRUE () )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Freight
		lineageTag: 8caa7315-3e77-4924-ab26-e212e724897c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Delivered Orders' =
			
			CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: fc8d7d36-2e31-486b-a780-3954922c6df6

	measure Customers =
			
			CALCULATE ( DISTINCTCOUNT ( Orders[customer_unique_id] ), Orders[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: Customers
		lineageTag: c862aab8-9513-46ae-ba6a-895eb3865ee6

	measure AOV =
			
			DIVIDE ( [GMV], [Delivered Orders] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Sales
		lineageTag: 20922ef0-4eab-416c-b2f9-ca30c552f0d1

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Freight Share' =
			
			DIVIDE ( [Freight], [GMV] + [Freight] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Freight
		lineageTag: 3a9f3ad8-285b-4b80-a9b9-3ecce10b80d2

	measure 'Late Rate' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE (), Orders[is_late] = TRUE () ),
			    CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE (), Orders[excl_delivery_time] = FALSE () )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: 5edf4021-902e-4444-bf76-d09175b97791

	measure 'Items Sold' =
			
			CALCULATE ( COUNTROWS ( 'Order Items' ), 'Order Items'[is_delivered] = TRUE () )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 32f02cbc-13f3-4efd-a852-9037721f7365

	measure 'Items per Order' =
			
			DIVIDE ( [Items Sold], [Delivered Orders] )
		formatString: 0.00
		displayFolder: Sales
		lineageTag: a2debfe0-93ef-4ed3-bb69-827863da9bbd

	measure 'Avg Item Price' =
			
			DIVIDE ( [GMV], [Items Sold] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Sales
		lineageTag: 1ebbaa03-bf7b-4e42-abd2-cf3e2daf0a9c

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Returned Customers' =
			
			COUNTROWS (FILTER( values('Orders'[customer_unique_id]), CALCULATE(
			            DISTINCTCOUNT(Orders[purchase_date_key]),Orders[is_delivered] = TRUE()
			       ) >= 2
			    )
			)
		formatString: #,0
		displayFolder: Customers
		lineageTag: 244f249f-8aa9-47fa-8391-919f94911ea8

	measure 'Return Rate' =
			
			DIVIDE ( [Returned Customers], [Customers] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: 91a633c6-7838-43ff-9c59-11f6f703f001

	measure 'Late Orders' =
			
			CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE (), Orders[is_late] = TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 9d898dff-2981-40e3-ba25-a61eddd1ef23

	measure 'Avg Review Score' =
			
			CALCULATE ( AVERAGE ( Orders[review_score] ), Orders[is_delivered] = TRUE () )
		formatString: 0.00
		displayFolder: Delivery
		lineageTag: a40c6fbb-9068-4762-9775-e9ce77f2d5b8

	measure 'Orders Delivered (by delivery date)' =
			
			CALCULATE (
			    [Delivered Orders],
			    USERELATIONSHIP ( 'Date'[date_key], Orders[delivered_date_key] )
			)
		formatString: #,0
		displayFolder: Delivery
		lineageTag: f7fff650-5998-48f3-b15f-0d74414dc7ac

	measure 'Low Score Rate' =
			
			DIVIDE (
			    CALCULATE (
			        COUNTROWS ( Orders ),
			        Orders[is_delivered] = TRUE (),
			        Orders[has_review] = TRUE (),
			        Orders[review_score] <= 2
			    ),
			    CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE (), Orders[has_review] = TRUE () )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: 4edd83fa-47dd-4291-9e84-5d1e606ca4f2

	measure 'GMV LY' =
			
			CALCULATE (
			    [GMV],
			    SAMEPERIODLASTYEAR ( 'Date'[full_date] ),
			    'Date'[in_analysis_period] = TRUE ()
			)
		formatString: #,0
		displayFolder: Time intelligence
		lineageTag: 0416e359-1b3d-4458-9945-830e864965cf

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Delivered Orders LY' =
			
			CALCULATE (
			    [Delivered Orders],
			    SAMEPERIODLASTYEAR ( 'Date'[full_date] ),
			    'Date'[in_analysis_period] = TRUE ()
			)
		formatString: #,0
		displayFolder: Time intelligence
		lineageTag: 9f50612c-482e-499c-aa05-2c37d6e712f9

	measure 'AOV LY' =
			
			DIVIDE ( [GMV LY], [Delivered Orders LY] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Time intelligence
		lineageTag: 6e1a8180-423a-413f-9ebc-aa086fd07d95

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'GMV Change' =
			
			IF ( HASONEVALUE ( 'Date'[year] ), [GMV] - [GMV LY] )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Time intelligence
		lineageTag: 141b4883-0275-4e9e-a341-55d557590a38

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'GMV YoY %' =
			
			IF ( HASONEVALUE ( 'Date'[year] ), DIVIDE ( [GMV] - [GMV LY], [GMV LY] ) )
		displayFolder: Time intelligence
		lineageTag: 8e9d9893-21e4-40e2-b584-a083a5fd3d55

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Orders YoY %' =
			
			IF ( HASONEVALUE ( 'Date'[year] ), DIVIDE ( [Delivered Orders] - [Delivered Orders LY], [Delivered Orders LY] ) )
		displayFolder: Time intelligence
		lineageTag: 1e432e7a-811c-4067-bf61-cb95cd0e2144

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'AOV YoY %' =
			
			IF ( HASONEVALUE ( 'Date'[year] ), DIVIDE ( [AOV] - [AOV LY], [AOV LY] ) )
		displayFolder: Time intelligence
		lineageTag: 7b02f262-e039-43a5-8bfd-bda00fba911a

		formatStringDefinition = "+0.0%;-0.0%;0.0%"

	measure 'Return Rate 90d' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'Customer Value' ),
			                'Customer Value'[eligible_90d] = TRUE (), 'Customer Value'[returned_90d] = TRUE () ),
			    CALCULATE ( COUNTROWS ( 'Customer Value' ), 'Customer Value'[eligible_90d] = TRUE () )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: 9dc926b8-0fcd-4197-8197-5dc41c0fa11f

	measure 'Return Rate 180d' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( 'Customer Value' ),
			                'Customer Value'[eligible_180d] = TRUE (), 'Customer Value'[returned_180d] = TRUE () ),
			    CALCULATE ( COUNTROWS ( 'Customer Value' ), 'Customer Value'[eligible_180d] = TRUE () )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: 45f972df-c7cd-4330-bf39-b8f47a92691f

	measure 'Returner GMV Share' =
			
			DIVIDE (
			    CALCULATE ( SUM ( 'Customer Value'[gmv] ), 'Customer Value'[is_returner] = TRUE () ),
			    SUM ( 'Customer Value'[gmv] )
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: 667dddc5-e0fd-4b6f-a02e-82b4f0727287

	measure 'Customer Share' =
			
			DIVIDE ( COUNTROWS ( 'Customer Value' ), CALCULATE ( COUNTROWS ( 'Customer Value' ), ALL ( 'Customer Value' ) ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: 0575a22e-9e6e-4194-b60c-654615243c2d

	measure 'CV Customers' =
			
			COUNTROWS ( 'Customer Value' )
		formatString: #,0
		displayFolder: Customers
		lineageTag: 3b6bd16b-420d-4fa0-87c8-34e9f904b45c

	measure 'Customer GMV Share' =
			
			DIVIDE ( SUM ( 'Customer Value'[gmv] ), CALCULATE ( SUM ( 'Customer Value'[gmv] ), ALL ( 'Customer Value' ) ) )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: a96c64d2-3ece-42ea-8db2-e41fa4dd0f59

	measure 'Cohort Return Rate 90d' =
			
			VAR CohortEnd = EOMONTH ( MAX ( 'Customer Value'[cohort_month] ), 0 )
			RETURN
			    IF ( CohortEnd + 90 <= DATE ( 2018, 8, 31 ), [Return Rate 90d] )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Customers
		lineageTag: 815633a1-a255-4e6e-8f62-99517e876b1f

	measure 'Avg Score On Time' =
			
			CALCULATE ( [Avg Review Score], Orders[is_late] = FALSE () )
		formatString: 0.00
		displayFolder: Delivery
		lineageTag: d7a7878a-6814-4298-9053-7cd101a45aaa

	measure 'Avg Score Late' =
			
			CALCULATE ( [Avg Review Score], Orders[is_late] = TRUE () )
		formatString: 0.00
		displayFolder: Delivery
		lineageTag: b36be7e6-c3f0-4d6b-82bf-90734344b741

	measure 'Late Share of Low Scores' =
			
			DIVIDE (
			    CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE (), Orders[has_review] = TRUE (),
			                Orders[review_score] <= 2, Orders[is_late] = TRUE () ),
			    CALCULATE ( COUNTROWS ( Orders ), Orders[is_delivered] = TRUE (), Orders[has_review] = TRUE (),
			                Orders[review_score] <= 2 )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: a6aac653-413f-4651-b5f7-077d2e9d7433

	measure 'Avg Transit Days' =
			
			CALCULATE (
			    AVERAGE ( Orders[carrier_transit_days] ),
			    Orders[is_delivered] = TRUE (), Orders[excl_delivery_time] = FALSE (),
			    Orders[excl_carrier_leg] = FALSE (), Orders[excl_handover] = FALSE ()
			)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: da2909c9-5435-4b0b-93bf-294ba732e5b9

	measure 'Avg Handover Days' =
			
			CALCULATE (
			    AVERAGE ( Orders[seller_handover_days] ),
			    Orders[is_delivered] = TRUE (), Orders[excl_delivery_time] = FALSE (),
			    Orders[excl_carrier_leg] = FALSE (), Orders[excl_handover] = FALSE ()
			)
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: f798a71c-7017-4890-b09b-5accab5e2c21

	measure 'Extra Transit Days (late)' =
			
			CALCULATE ( [Avg Transit Days], Orders[is_late] = TRUE () )
			    - CALCULATE ( [Avg Transit Days], Orders[is_late] = FALSE () )
		displayFolder: Delivery
		lineageTag: 223f0833-90a2-4ea7-951c-58db89474b2c

		formatStringDefinition = "+0.0;-0.0;0.0"

	measure 'Share of Late Orders' =
			
			DIVIDE ( [Late Orders], CALCULATE ( [Late Orders], ALL ( Orders[delivery_region] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: fb644941-6581-4ed6-a987-6d2145c69a21

	measure 'Extra Handover Days (late)' =
			
			CALCULATE ( [Avg Handover Days], Orders[is_late] = TRUE () )
			    - CALCULATE ( [Avg Handover Days], Orders[is_late] = FALSE () )
		displayFolder: Delivery
		lineageTag: d6c389f1-408c-43e1-8018-b60a3a24df9e

		formatStringDefinition = "+0.0;-0.0;0.0"

	measure 'Top 10% Sellers GMV Share' =
			
			CALCULATE ( [Seller GMV Share], 'Seller Value'[gmv_decile] = 1 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: 3e994b96-2a26-4013-a207-0c5d62d7fafd

	measure 'Active Sellers' =
			
			COUNTROWS ( 'Seller Value' )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 4f44992d-5d4d-4b1f-a594-389deb95a2f3

	measure 'Seller GMV' =
			
			SUM ( 'Seller Value'[gmv] )
		formatString: "R$"\ #,0;-"R$"\ #,0;"R$"\ #,0
		displayFolder: Sellers
		lineageTag: 11a1f4f7-e0e3-4fc0-87ea-237516b1d394

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Seller GMV Share' =
			
			DIVIDE ( [Seller GMV], CALCULATE ( [Seller GMV], ALL ( 'Seller Value' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: f7fd979b-5d1a-4dc3-84e1-c4711996b10b

	measure 'Seller Share' =
			
			DIVIDE ( [Active Sellers], CALCULATE ( [Active Sellers], ALL ( 'Seller Value' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: d74c3729-e581-480a-8bca-6c965a71fcb9

	measure 'Top 10 Sellers GMV Share' =
			
			CALCULATE ( [Seller GMV Share], 'Seller Value'[gmv_rank] <= 10 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: ce20e05d-48d4-4bf0-8572-4092e74d29b6

	measure 'Seller HHI' =
			
			VAR TotalGMV = CALCULATE ( SUM ( 'Seller Value'[gmv] ), ALL ( 'Seller Value' ) )
			RETURN
			    SUMX ( 'Seller Value', ( 100 * 'Seller Value'[gmv] / TotalGMV ) ^ 2 )
		formatString: 0.0
		displayFolder: Sellers
		lineageTag: 0898f5a9-4379-4d18-b66c-f15086c6d76c

	measure 'Equivalent Sellers' =
			
			DIVIDE ( 10000, [Seller HHI] )
		formatString: #,0
		displayFolder: Sellers
		lineageTag: 9ca13e76-e96e-4b6e-a4b8-a447fd7c85de

	measure 'Sellers Under 1k Share' =
			
			CALCULATE ( [Seller Share], 'Seller Value'[gmv_band] = "1. Under R$ 1k" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: 246a25e5-e6db-4bbc-b717-14132704ef56

	measure 'One-Order Seller Share' =
			
			CALCULATE ( [Seller Share], 'Seller Value'[is_one_order_seller] = TRUE () )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: c0902f00-fff0-4f39-a15d-806c388151d3

	measure 'Seller Late Rate' =
			
			DIVIDE ( SUM ( 'Seller Value'[late_items] ), SUM ( 'Seller Value'[timed_items] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: 85f9f22e-3f94-45db-a910-74dd9524e865

	measure 'Seller Handover Late Rate' =
			
			DIVIDE ( SUM ( 'Seller Value'[handover_late_items] ), SUM ( 'Seller Value'[timed_items] ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sellers
		lineageTag: 696d3921-4737-4475-99df-3d2876714ba6

	measure 'Freight per Item' =
			
			DIVIDE ( [Freight], [Items Sold] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: Freight
		lineageTag: 084dc6ee-4665-40b6-8afc-12d820b237d8

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Median Order Freight Share' =
			
			MEDIANX (
			    FILTER ( Orders, Orders[is_delivered] = TRUE () ),
			    DIVIDE ( Orders[order_freight], Orders[order_gmv] + Orders[order_freight] )
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Freight
		lineageTag: 4f0d140b-535f-408d-aeff-7aad7698e9f4

	measure 'Orders Over 25% Freight' =
			
			DIVIDE (
			    COUNTROWS (
			        FILTER (
			            Orders,
			            Orders[is_delivered] = TRUE ()
			                && DIVIDE ( Orders[order_freight], Orders[order_gmv] + Orders[order_freight] ) > 0.25
			        )
			    ),
			    [Delivered Orders]
			)
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Freight
		lineageTag: 2d3ecf02-5a21-4979-bd52-a8a499926bce

	measure 'Freight Share Under R$50' =
			
			CALCULATE ( [Freight Share], 'Order Items'[price_band] = "1. Under R$ 50" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Freight
		lineageTag: 028a07a4-f600-43d6-b6a4-9222f6588927

	measure 'Freight Share R$200+' =
			
			CALCULATE ( [Freight Share], 'Order Items'[price_band] = "4. R$ 200 and over" )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Freight
		lineageTag: f6b744f0-cf1c-4584-bb68-df57b69afb7e

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

